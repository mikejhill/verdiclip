<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="VerdiClip">
  <Profiles>
    <SystemCollector Id="SchedulerCollector" Name="VerdiClip Scheduler">
      <BufferSize Value="1024"/>
      <Buffers Value="64"/>
    </SystemCollector>
    <SystemProvider Id="SchedulerProvider">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="CSwitch"/>
        <Keyword Value="ReadyThread"/>
      </Keywords>
    </SystemProvider>
    <Profile Id="VerdiClipWaits.Verbose.Memory" Name="VerdiClipWaits"
             Description="Bounded scheduler-only diagnostic" LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SchedulerCollector">
          <SystemProviderId Value="SchedulerProvider"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
